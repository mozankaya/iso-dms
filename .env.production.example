# Production settings. Copy to .env.production (never commit it) and fill in every value, or let
# ops/generate-secrets.sh make the file with random secrets. Start the stack with ops/dc up -d --build.

# --- Addresses ---------------------------------------------------------------------------------------------------
# Two names that both reach this server: the application, and the document server (the editor).
# Public names get a Let's Encrypt certificate (CADDYFILE=Caddyfile); on an internal network use
# CADDYFILE=Caddyfile.internal (and have the browsers trust the proxy's root certificate, see ops/README.md).
APP_HOST=kalite.example.com
DOCS_HOST=docs.kalite.example.com
CADDYFILE=Caddyfile
# Image tag; change it at every update so an older version can be started again
APP_VERSION=latest

# --- Secrets (ops/generate-secrets.sh fills these; at least 24 characters, letters and digits only) ----------------
POSTGRES_USER=iso_dms
POSTGRES_PASSWORD=__GENERATE__
POSTGRES_DB=iso_dms
S3_ACCESS_KEY=iso_dms
S3_SECRET_KEY=__GENERATE__
S3_BUCKET=documents
JWT_ACCESS_SECRET=__GENERATE__
JWT_REFRESH_SECRET=__GENERATE__
FILE_TOKEN_SECRET=__GENERATE__
ONLYOFFICE_JWT_SECRET=__GENERATE__

# --- First data (only used when the database is empty; later changes are made in the application) ----------------
SEED_ORGANIZATION_NAME=Kurumunuzun Adı
SEED_ORGANIZATION_SLUG=kurum
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_FULL_NAME=Sistem Yöneticisi
# At least 12 characters. The administrator has to choose a new one at the first login.
SEED_ADMIN_PASSWORD=__GENERATE__

# --- Optional ----------------------------------------------------------------------------------------------------
# E-mail for the notifications. Without SMTP_HOST nothing is sent and messages stay in the application.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Kalite Doküman Yönetim Sistemi <noreply@kalite.example.com>"
MAX_UPLOAD_MB=25
LOGIN_RATE_LIMIT=5

# --- Backups (ops/backup.sh; see ops/README.md) --------------------------------------------------------------------
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=30
BACKUP_KEEP_MIN=3
# A second place (mounted share, other disk): a backup on the same disk as the data is not a backup
BACKUP_COPY_TO=
