# General
NODE_ENV=development
TZ=Europe/Istanbul

# API
API_PORT=4000
# Address ONLYOFFICE uses to reach the API.
# Local dev (api runs on host): http://host.docker.internal:4000 — Docker-only: http://api:4000
API_INTERNAL_URL=http://host.docker.internal:4000
WEB_URL=http://localhost:3000
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
FILE_TOKEN_SECRET=change-me

# Database (credentials are also used by docker-compose)
POSTGRES_USER=iso_dms
POSTGRES_PASSWORD=iso_dms
POSTGRES_DB=iso_dms
# Host port (5433 to avoid clashing with a local Postgres on 5432)
POSTGRES_PORT=5433
# Local dev (api on host): localhost:5433 — Docker-only: postgres:5432
DATABASE_URL=postgresql://iso_dms:iso_dms@localhost:5433/iso_dms

# S3-compatible object storage (RustFS; also used by docker-compose)
# Local dev (api on host): localhost — Docker-only: storage
S3_ENDPOINT=localhost
S3_PORT=9000
S3_ACCESS_KEY=iso_dms
S3_SECRET_KEY=change-me-please
S3_BUCKET=documents

# ONLYOFFICE
# Address the browser uses to reach ONLYOFFICE
ONLYOFFICE_PUBLIC_URL=http://localhost:8080
# Address the API uses to reach ONLYOFFICE (to fetch saved files). Local dev: localhost — Docker-only: http://onlyoffice
ONLYOFFICE_INTERNAL_URL=http://localhost:8080
ONLYOFFICE_JWT_SECRET=change-me

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_ONLYOFFICE_URL=http://localhost:8080

# Seed (initial organization and admin user; change the password!)
SEED_ORGANIZATION_NAME=Örnek Kurum
SEED_ORGANIZATION_SLUG=ornek-kurum
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_FULL_NAME=Sistem Yöneticisi
SEED_ADMIN_PASSWORD=ChangeMe123!

# Per-IP login attempts per minute
LOGIN_RATE_LIMIT=5

# Object storage / uploads
S3_USE_SSL=false
MAX_UPLOAD_MB=25

# Redis (background jobs: PDF copies of published revisions)
REDIS_URL=redis://localhost:6379
# Keeps the queues of different environments (dev, tests) apart on one Redis
REDIS_QUEUE_PREFIX=iso-dms
# false: nothing is queued and no worker runs (tests that do not need PDFs)
PDF_WORKER_ENABLED=true
